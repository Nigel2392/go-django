{{ template "base" . }}

{{ define "title" }}{{ T "Editing Site Settings" }}{{ end }}

{{ define "extra_css" }}
    {{ range $css := .Page.Media.CSS }}
        {{ $css }}
    {{ end }}
    {{ $Media := (.Get "form").Media }}
    {{ range $css := $Media.CSS }}
        {{ $css }}
    {{ end }}
    <link rel="stylesheet" href="{{ static "settings/css/settings.css" }}">
{{ end }}

{{ define "content" }}

    <form method="post" action="{{ url "admin:settings:edit" }}" class="admin-form settings-change-form" enctype="multipart/form-data" data-controller="form">
        
        <div class="alert warning">
            <div class="alert-title">
                {{ T "You are currently editing the websites' settings" }}
            </div>
            <p>{{ T "It is possible you cannot see or change all settings, you may need to contact your administrator for extra permissions." }}</p>
            <p>{{ T "Any changes made here are instant and will have immediate impact on the website." }}</p>
        </div>
        
        {{ csrf_field }}

        {{ include . "settings/shared/display.tmpl" }}

        <div class="form-buttons">
            <input class="button secondary" type="submit" value="{{ T "Save Changes" }}">
            <a class="button warning" href="{{ url "admin:settings" }}">{{ T "Cancel" }}</a>
        </div>
    </form>

{{ end }}

{{ define "extra_js" }}
    {{ range $js := .Page.Media.JS }}
        {{ $js }}
    {{ end }}
    {{ $Media := (.Get "form").Media }}
    {{ range $js := $Media.JS }}
        {{ $js }}
    {{ end }}
{{ end }}